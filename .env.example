# ─────────────────────────────────────────
# BookMind — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────

# App
APP_NAME=BookMind
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://bookmind:bookmind@localhost:5432/bookmind
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# ─── AI / LLM ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude Sonnet 4
OPENAI_API_KEY=sk-...                 # text-embedding-3-small

# ─── Book Data APIs ───────────────────────
# Open Library — Free, no key needed
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Google Books — Free, get key at console.cloud.google.com
GOOGLE_BOOKS_API_KEY=AIza...

# NYT Books — Free, get at developer.nytimes.com
NYT_BOOKS_API_KEY=...

# Common Sense Media — For kids content safety ratings
# Apply at: developers.commonsense.org
COMMON_SENSE_MEDIA_API_KEY=...

# ─── Affiliate Links ──────────────────────
# Amazon Associates — apply at affiliate-program.amazon.com
AMAZON_AFFILIATE_TAG=bookmind-20

# Bookshop.org — apply at bookshop.org/affiliates (instant approval)
BOOKSHOP_AFFILIATE_ID=...

# Audible — apply at audible.com/ep/affiliate-program
AUDIBLE_AFFILIATE_TAG=bookmind-audible-20

# ThriftBooks — apply at thriftbooks.com/affiliates
THRIFTBOOKS_AFFILIATE_ID=...

# ─── Email ────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=hello@bookmind.app
SENDGRID_FROM_NAME=BookMind

# ─── Observability ────────────────────────
# Langfuse — get at cloud.langfuse.com (free tier)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Workers ──────────────────────────────
BOOK_SYNC_INTERVAL_HOURS=24        # How often to sync new books
DIGEST_SEND_DAY=monday             # Day to send weekly digest
DIGEST_SEND_HOUR=8                 # Hour (UTC) to send digest

# ─── Rate Limits ──────────────────────────
MAX_RECS_PER_REQUEST=10
EMBEDDING_BATCH_SIZE=100
